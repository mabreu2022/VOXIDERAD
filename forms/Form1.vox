// ==============================================================================
// Form1.vox — Unidade RAD Gerada pelo Vox Studio
// ==============================================================================

import Vox_UI, Vox_Database, Vox_SysUtils;

classe Form1 herda TVoxForm {
private:
    // ── Membros e Métodos Privados ──────────────────────────────────────────
    var _initialized: bool;

    private procedure LogInterno(msg: str) {
        println("[DEBUG INTERNO] " + msg);
    }

published:
    // ── Propriedades e Componentes Publicados (Object Inspector) ─────────────
    var width: int;
    var height: int;
    var title: str;
    let mut vox_webview1: TVoxWebView;

public:
    // ── Construtor e Inicialização de Tela ────────────────────────────────────
    new() {
        this.title = "Form1";
        this.width = 700;
        this.height = 480;
        this._initialized = true;

        this.vox_webview1 = new TVoxWebView();
        this.vox_webview1.left = 0;
        this.vox_webview1.top = 0;
        this.vox_webview1.width = 700;
        this.vox_webview1.height = 452;
        this.vox_webview1.align = "alClient";
        this.vox_webview1.url = "https://www.uol.com.br/";
        this.vox_webview1.html = """<h2 style="color:#38bdf8;font-family:sans-serif;padding:16px;">Olá do TVoxWebView! 🌐</h2>
<p style="font-family:sans-serif;padding:0 16px;color:#64748b;">Edite o conteúdo HTML, CSS, JavaScript ou TypeScript
em ✏️ Editar Conteúdo no Object Inspector.</p>""";
        this.vox_webview1.css = """body { background: #0f172a; } h2 { margin-top: 24px; }""";
        this.vox_webview1.useTypeScript = false;
        this.vox_webview1.sandbox = false;
        this.vox_webview1.allowFullscreen = false;
        this.vox_webview1.scrollBars = true;
        this.vox_webview1.zoomFactor = 100;

        println("Formulário " + this.title + " inicializado no Vox Studio.");
    }


    // Tratador de Evento Publicado: Form1 -> OnCreate
    public procedure FormCreate(sender: any) {
        println("Formulário Form1 carregado com sucesso!");
    }
}

// ── Ponto de Entrada para Execução Standalone ─────────────────────────────────
public fn main() -> void {
    let app = new Form1();
    println("Janela ativa: " + app.title + " [" + str(app.width) + "x" + str(app.height) + "]");
}
