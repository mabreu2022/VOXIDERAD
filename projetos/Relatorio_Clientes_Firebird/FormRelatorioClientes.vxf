    {
      "id": "comp_conn_fb",
      "name": "vox_Connection1",
      "type": "vox_Connection",
      "left": 20,
      "top": 10,
      "width": 38,
      "height": 38,
      "props": {
        "DriverName": "Firebird",
        "IP": "127.0.0.1",
        "Porta": 3050,
        "Database": "projetos/Relatorio_Clientes_Firebird/dados/clientes.fdb",
        "Login": "SYSDBA",
        "Senha": "masterkey",
        "VendorLib": "fbclient.dll",
        "Connected": true
      }
    },
    {
      "id": "comp_qry_fb",
      "name": "vox_Query1",
      "type": "vox_Query",
      "left": 68,
      "top": 10,
      "width": 38,
      "height": 38,
      "props": {
        "Connection": "vox_Connection1",
        "SQL": "SELECT ID, CODIGO, NOME, EMAIL, TELEFONE, CIDADE, UF, SALDO, STATUS FROM CLIENTES ORDER BY ID",
        "Active": true
      }
    },
    {
